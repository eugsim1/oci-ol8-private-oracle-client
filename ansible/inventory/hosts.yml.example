---
all:
  children:
    oracle_linux:
      hosts:
        private_oracle_server:
          ansible_host: 10.30.1.10
          ansible_user: oracle
          ansible_ssh_private_key_file: /home/admin/.ssh/id_ed25519
          ansible_ssh_common_args: >-
            -o StrictHostKeyChecking=accept-new
            -o ProxyCommand="ssh -i /home/admin/.ssh/id_ed25519 -o StrictHostKeyChecking=accept-new -W %h:%p -p 22 SESSION_OCID@host.bastion.eu-paris-1.oci.oraclecloud.com"
